package com.thesis.geckowifi.data.local

import android.content.Context
import androidx.datastore.preferences.core.*
import androidx.datastore.preferences.preferencesDataStore
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.map
import kotlinx.serialization.Serializable
import kotlinx.serialization.encodeToString
import kotlinx.serialization.json.Json

/** F-PKI-style scoped trust: a CA is trusted only within a bounding region. */
@Serializable
data class CATrustEntry(
    val caFingerprint: String,
    val label: String,
    val trustLevel: Int,
    val minLat: Double? = null, val maxLat: Double? = null,
    val minLng: Double? = null, val maxLng: Double? = null
) {
    fun appliesAt(lat: Double, lng: Double): Boolean {
        if (minLat == null || maxLat == null || minLng == null || maxLng == null) return true
        return lat in minLat..maxLat && lng in minLng..maxLng
    }
}

private val Context.dataStore by preferencesDataStore("trust_preferences")

class TrustPreferenceStore(private val context: Context) {

    private object Keys {
        val STRICT_MODE = booleanPreferencesKey("strict_mode")
        val QUERY_RADIUS = intPreferencesKey("query_radius_meters")
        val CA_ENTRIES = stringPreferencesKey("ca_entries")
        val ONBOARDED = booleanPreferencesKey("onboarded")
    }

    private val json = Json { ignoreUnknownKeys = true }

    val strictMode: Flow<Boolean> =
        context.dataStore.data.map { it[Keys.STRICT_MODE] ?: false }

    val queryRadiusMeters: Flow<Int> =
        context.dataStore.data.map { it[Keys.QUERY_RADIUS] ?: 50 }

    val onboarded: Flow<Boolean> =
        context.dataStore.data.map { it[Keys.ONBOARDED] ?: false }

    val caEntries: Flow<List<CATrustEntry>> = context.dataStore.data.map { prefs ->
        prefs[Keys.CA_ENTRIES]?.let {
            runCatching { json.decodeFromString<List<CATrustEntry>>(it) }.getOrDefault(emptyList())
        } ?: emptyList()
    }

    suspend fun setStrictMode(enabled: Boolean) =
        context.dataStore.edit { it[Keys.STRICT_MODE] = enabled }.let { }

    suspend fun setQueryRadius(meters: Int) =
        context.dataStore.edit { it[Keys.QUERY_RADIUS] = meters }.let { }

    suspend fun setOnboarded(done: Boolean) =
        context.dataStore.edit { it[Keys.ONBOARDED] = done }.let { }

    suspend fun upsertCA(entry: CATrustEntry) {
        context.dataStore.edit { prefs ->
            val current = prefs[Keys.CA_ENTRIES]?.let {
                runCatching { json.decodeFromString<List<CATrustEntry>>(it) }.getOrDefault(emptyList())
            } ?: emptyList()
            val updated = current.filterNot { it.caFingerprint == entry.caFingerprint } + entry
            prefs[Keys.CA_ENTRIES] = json.encodeToString(updated)
        }
    }
}