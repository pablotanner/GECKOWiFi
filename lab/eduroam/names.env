# Canonical names for the eduroam onboarding demo (docs/eduroam-demo.md).
#
# Sourced by make-pki.sh (and the human-readable reference for everything
# else). These are IDENTIFIERS, not secrets: realms, identities, server names
# and CA common names. Secrets (the test password, RADIUS shared secrets) live
# in lab-secrets/radius/secrets.env, never here.
#
# NOTE: the app's Kotlin constants (OnboardingSession.kt), the realm-record and
# GeoCert JSON, the FreeRADIUS overlay (setup-instances.sh) and the docs carry
# these values LITERALLY - a compiled app and signed artifacts can't read this
# file at runtime. This file is the single list to reason from; after changing
# it, re-run the reprovision in docs/eduroam-reprovision.md so the rest follows.
#
# .ch is a real TLD, used here only as an identifier / certificate name; the lab
# never resolves it (RADIUS is reached by IP, server names are matched against
# the certificate, not DNS).

# --- Home institution (the user's IdP / realm) ---
HOME_REALM=uni-wipkingen.ch
HOME_DISPLAY_NAME="Uni Wipkingen"
TEST_USER=pablo
RADIUS_SERVER_NAME=radius-service.uni-wipkingen.ch

# --- Onboarding service provider (GECKO) ---
SP_REALM=gecko.ch
SP_OPERATOR="Gecko SP"
ONBOARD_USER=fetch
ONBOARD_PASSWORD=gecko            # public on purpose, not a secret
ONBOARD_SERVER_NAME=onboard.gecko.ch

# --- Derived identities (assembled from the above) ---
TEST_IDENTITY="${TEST_USER}@${HOME_REALM}"        # pablo@uni-wipkingen.ch
OUTER_IDENTITY="anonymous@${HOME_REALM}"          # anonymous@uni-wipkingen.ch
ONBOARD_IDENTITY="${ONBOARD_USER}@${SP_REALM}"    # fetch@gecko.ch

# --- Certificate authorities and cert file basenames (lab-secrets/pki) ---
PKI_ORG="Uni Wipkingen"
LEGIT_CA_CN="Uni Wipkingen CA"
LEGIT_CA_FILE=uni-wipkingen-ca
ROGUE_CA_CN="Rogue CA"
ROGUE_CA_FILE=rogue-ca
LEGIT_CERT_FILE=radius-service       # genuine RADIUS cert (home + onboarding names)
ROGUE_CERT_FILE=radius-rogue         # attacker B1 cert (rogue CA)
B2_CERT_FILE=radius-b2               # attacker B2 cert (valid onboarding name only)

# --- Network / site ---
SITE_SSID=eduroam-lab                # never 'eduroam' (campus safety)
SITE_FEDERATION=eduroam-lab
SITE_CERT_ID=eduroam-lab-sp
WALLED_GARDEN_VLAN=99
ONBOARD_SESSION_TIMEOUT=60
