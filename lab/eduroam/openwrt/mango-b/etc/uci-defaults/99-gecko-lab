#!/bin/sh
# First boot of vanilla OpenWrt on Router B (docs/flashing-openwrt.md):
# recreates what B did under GL firmware, so the laptop reaches it as before
# (ssh mango-b, through A) and lab/scenarios/*.ps1 keep working.
# Restored by `sysupgrade -f`, runs once, deleted by OpenWrt afterwards.

uci set system.@system[0].hostname='mango-b'
uci set system.@system[0].zonename='Europe/Zurich'
uci set system.@system[0].timezone='CET-1CEST,M3.5.0,M10.5.0/3'

# LAN as before; WAN stays DHCP from A, which reserves 192.168.8.115 for B's MAC.
uci set network.lan.ipaddr='192.168.247.1'

# SSH from A's LAN only (the laptop reaches B through A), keys only.
uci set dropbear.@dropbear[0].PasswordAuth='off'
uci set dropbear.@dropbear[0].RootPasswordAuth='off'
uci set firewall.gecko_ssh=rule
uci set firewall.gecko_ssh.name='GECKO-SSH-from-A'
uci set firewall.gecko_ssh.src='wan'
uci set firewall.gecko_ssh.src_ip='192.168.8.0/24'
uci set firewall.gecko_ssh.proto='tcp'
uci set firewall.gecko_ssh.dest_port='22'
uci set firewall.gecko_ssh.target='ACCEPT'

# Wi-Fi as before: open GeckoTest on channel 11. The interface section is
# named wifi2g like under GL, which lab/scenarios/*.ps1 use.
[ -n "$(uci -q get wireless.radio0)" ] || wifi config
uci -q rename wireless.default_radio0='wifi2g'
uci set wireless.radio0.disabled='0'
uci set wireless.radio0.channel='11'
uci set wireless.radio0.htmode='HT20'
uci set wireless.radio0.country='DE'
uci set wireless.wifi2g.ssid='GeckoTest'
uci set wireless.wifi2g.encryption='none'
uci set wireless.wifi2g.network='lan'
uci set wireless.wifi2g.mode='ap'
# Since 25.12 the generated interface section is disabled, not the radio.
uci set wireless.wifi2g.disabled='0'
# The Wi-Fi LED is generated for 'wlan0'; 25.12 names the interface phy0-ap0.
uci -q set system.led_wifi_led.dev='phy0-ap0'

# DNS overrides as before (lab/scenarios/reset.ps1 rewrites them per scenario).
uci -q delete dhcp.@dnsmasq[0].address
uci add_list dhcp.@dnsmasq[0].address='/status.client/192.168.247.1'
uci add_list dhcp.@dnsmasq[0].address='/portal.gecko-a.lab/192.168.137.20'

uci commit

# Root password (B's LAN is an open Wi-Fi); value from lab-secrets, filled in by make-preseed.sh.
printf '%s\n%s\n' '@ROOT_PASSWORD@' '@ROOT_PASSWORD@' | passwd root >/dev/null 2>&1

exit 0
