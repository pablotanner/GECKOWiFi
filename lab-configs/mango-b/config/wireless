
config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/10300000.wmac'
	option band '2g'
	option channel '11'
	option htmode 'HT20'
	option disabled '0'
	option country 'DE'
	option txpower '5'

config wifi-iface 'wifi2g'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'GeckoTest'
	option encryption 'none'
	option disabled '0'

config wifi-iface 'eduroam_b1'
	option device 'radio0'
	option mode 'ap'
	option network 'lan'
	option ssid 'eduroam-lab'
	option encryption 'wpa2'
	option auth_server '192.168.137.1'
	option auth_port '1814'
	option auth_secret '<redacted, see lab-secrets/router-backups>'
	option disabled '1'

config wifi-iface 'eduroam_legit'
	option device 'radio0'
	option mode 'ap'
	option network 'edu'
	option ssid 'eduroam-lab'
	option encryption 'wpa2'
	option auth_server '192.168.137.1'
	option auth_port '1812'
	option auth_secret '<redacted, see lab-secrets/router-backups>'
	option dynamic_vlan '1'
	option disabled '1'

config wifi-vlan 'onboard_vlan'
	option name 'onb'
	option vid '99'
	list network 'onboard'
	list iface 'eduroam_legit'
	option isolate '1'

