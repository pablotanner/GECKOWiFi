
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '0004949f8c18bdc74e03a2a4448107e396bd'
	option ula_prefix 'fd7c:1fd1:884b::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0.1'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.247.1/24'
	option ip6assign '60'

config interface 'wan'
	option device 'eth0.2'
	option proto 'dhcp'

config interface 'wan6'
	option device 'eth0.2'
	option proto 'none'

config switch
	option name 'switch0'
	option reset '1'
	option enable_vlan '1'

config switch_vlan
	option device 'switch0'
	option vlan '1'
	option ports '1 6t'

config switch_vlan
	option device 'switch0'
	option vlan '2'
	option ports '0 6t'

config device 'edu_dev'
	option name 'br-edu'
	option type 'bridge'
	option bridge_empty '1'

config interface 'edu'
	option proto 'static'
	option device 'br-edu'
	option ipaddr '10.98.0.1'
	option netmask '255.255.255.0'

config device 'onboard_dev'
	option name 'br-onboard'
	option type 'bridge'
	option bridge_empty '1'

config interface 'onboard'
	option proto 'static'
	option device 'br-onboard'
	option ipaddr '10.99.0.1'
	option netmask '255.255.255.0'

